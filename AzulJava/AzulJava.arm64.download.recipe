<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the specified build of Azul Java (JRE/JDK) for arm64 systems.</string>
    <key>Identifier</key>
    <string>com.github.chaospeach.azuljava.arm64.download</string>
    <key>Input</key>
    <dict>
        <key>BASE_VERSION</key>
        <string />
        <key>ARCHITECTURE</key>
        <string>arm64</string>
        <key>ENVIRONMENT</key>
        <string />
        <key>NAME</key>
        <string>%NAME%</string>
    </dict>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>ParentRecipe</key>
    <string>com.github.chaospeach.azuljava.download</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
    </array>
</dict>
</plist>
